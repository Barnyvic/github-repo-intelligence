generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SearchHistory {
  id           String   @id @default(cuid())
  searchType   String
  query        String
  filters      Json
  resultCount  Int
  createdAt    DateTime @default(now())

  @@index([searchType, createdAt])
  @@index([createdAt])
}
